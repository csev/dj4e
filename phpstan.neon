# Static analysis for PHP 8.4 and 8.5. No web server is involved.
# Tsugi is scanned for symbols only; its own code is not reported.
# Locally, the gitignored tsugi/ checkout must be present.
# Run: composer phpstan
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 3
    phpVersion:
        min: 80400   # PHP 8.4
        max: 80500   # PHP 8.5
    stubFiles:
        - phpstan-stubs.php
    scanFiles:
        - phpstan-stubs.php
        - tsugi/lib/include/setup.php
        - tsugi/lib/include/setup_i18n.php
        # setup.php loads these. This site calls the functions and constants they define.
        - tsugi/lib/include/tsugi_constants.php
        - tsugi/lib/include/lms_lib.php
        # Class only. The copies under assn/, md/, project/, and old/ are not analysed.
        - assn/Parsedown.php
    scanDirectories:
        - tsugi/lib/src
        - tsugi/koseu/src
        # Autograders call these classes. They ship in the Tsugi checkout, not in this repo.
        - tsugi/vendor/symfony/browser-kit
        - tsugi/vendor/symfony/dom-crawler
        - tsugi/vendor/symfony/http-client
        - tsugi/vendor/symfony/http-client-contracts
        - tsugi/vendor/symfony/mime
    paths:
        - index.php
        - nav.php
        - buildmenu.php
        - top.php
        - footer.php
        - privacy.php
        - launcherror.php
        - tsugi.php
        - coursesredirect.php
        - sanity.php
        - rosetta.php
        - versions.php
        - dj4e_django_version.php
        - tsugi_settings.php
        - tools
        - assn
        - project
        - md
        - cron
        - code
        - old
    excludePaths:
        # Vendored Parsedown copies. Not this site's code.
        - **/Parsedown.php
    reportUnmatchedIgnoredErrors: true
    checkMaybeUndefinedVariables: false
    # Tsugi still ships these APIs. They are deprecated inside Tsugi, not by PHP.
    ignoreErrors:
        -
            message: '#deprecated class (Tsugi\\Core\\Settings|Koseu\\Core\\Application)#'
        -
            message: '#deprecated method ltiCustomGet\(\)#'
